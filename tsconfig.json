{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noImplicitAny": true,
    "sourceMap": false,
    "declaration": true
  },
  "include": ["xest.ts", "cli/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "api-sample",
    "documentation",
    "cli/commands/deploy/utils/stack"
  ]
}
