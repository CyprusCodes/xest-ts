import * as yup from 'yup';
{{ filteredFinalColumns | schemaImports }}

/**
 * Validation schema for deleting {{ entityName | toPascalCase }}
 */
const newDelete{{ entityName | toPascalCase }}Schema = yup.object().shape({
{%- for column in filteredFinalColumns %}
    {%- if column.foreignKeyTo %}
    {{ column.column | toCamelCase }}: yup
      .number()
      .integer()
      .required()
      .label('{{ column.column | toCamelCase }}')
      .typeError('The {{ column.column | toCamelCase }} field must be a number')
      .test(
        'doesExist',
        'The {{ column.column | toCamelCase }} field must be a valid {{ column.column | toCamelCase }}',
        async function (value) {
          if (value === undefined || value === null) return false;

          const count = await select{{ column.foreignKeyTo.targetTable | toPascalCase }}ById({ 
            {%- if column.column != column.foreignKeyTo.targetColumn %}
            {{ column.foreignKeyTo.targetColumn | toCamelCase }}: value
            {%- else %}
            {{ column.column | toCamelCase }}: value
            {%- endif %}
          });

          return count > 0;
        }
      ),
    {%- endif %}
{%- endfor %}
});

export default newDelete{{ entityName | toPascalCase }}Schema;