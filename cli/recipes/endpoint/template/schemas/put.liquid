        'doesExist',
        'The {{ column.column | toCamelCase }} field must be a valid {{ column.column | toCamelCase }}',
        async function (value) {
          if (value === undefined || value === null) return true;
          const count = await select{{ column.foreignKeyTo.targetTable | toPascalCase }}ById({ 
            {%- if column.column != column.foreignKeyTo.targetColumn %}
            {{ column.foreignKeyTo.targetColumn | toCamelCase }}: value
            {%- else %}
            {{ column.column | toCamelCase }}: value
            {%- endif %}
