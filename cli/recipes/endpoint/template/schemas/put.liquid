          .number(){% unless column.dataType == 'float' or column.dataType == 'double' %}.integer(){% endunless %}
        {%- when 'json' -%}
          .object()
        {%- when 'tinyint', 'bit', 'boolean' -%}
          .boolean()
        {%- when 'datetime', 'date' -%}
          .date()
