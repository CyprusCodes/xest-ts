{%- endfor %}

{%- comment %} --- PART 2: Updateable Columns (Body) --- {% endcomment %}
{%- for column in uniqueSchemaColumns %}
  {{ column.column | toCamelCase }}: yup
    {%- if column.columnKey == 'MUL' and column.dataType == 'int' -%}
